'use client';

import { useState, useEffect } from 'react';
import { Badge } from '@/components/ui/badge';
import { Database, AlertCircle, CheckCircle2 } from 'lucide-react';
import { motion } from 'framer-motion';

export default function DBStatusIndicator() {
  const [status, setStatus] = useState<{ connected: boolean; type: string; error?: string } | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchStatus = async () => {
      try {
        const res = await fetch('/api/admin/db-status');
        if (res.ok) {
          const data = await res.json();
          setStatus(data);
        } else {
          setStatus({ connected: false, type: 'Error' });
        }
      } catch (err) {
        setStatus({ connected: false, type: 'Unreachable' });
      } finally {
        setLoading(false);
      }
    };

    fetchStatus();
  }, []);

  if (loading) {
    return (
      <div className="flex items-center gap-2 opacity-50">
        <div className="h-2 w-2 rounded-full bg-slate-400 animate-pulse" />
        <span className="text-xs font-medium text-slate-400 uppercase tracking-widest">Checking DB...</span>
      </div>
    );
  }

  return (
    <motion.div
      initial={{ opacity: 0 }}
      animate={{ opacity: 1 }}
      transition={{ duration: 0.3 }}
      className="absolute inset-0 bg-gradient-to-r from-green-400/20 to-emerald-400/20 pointer-events-none"
    />
    <div className="flex items-center gap-2">
      <Database className={`h-4 w-4 ${status?.connected ? 'text-emerald-400' : 'text-amber-400'}`} />
      <span className="text-xs font-bold text-slate-300 uppercase tracking-tight">
        System State:
      </span>
    </div>

      {status?.connected ? (
        <Badge className="bg-emerald-500/10 text-emerald-400 border-emerald-500/20 px-3 py-0.5 rounded-full flex items-center gap-1.5">
          <CheckCircle2 className="h-3 w-3" />
          <span className="text-[10px] font-black tracking-widest uppercase">Database Active</span>
        </Badge>
      ) : (
        <Badge className="bg-amber-500/10 text-amber-400 border-amber-500/20 px-3 py-0.5 rounded-full flex items-center gap-1.5">
          <AlertCircle className="h-3 w-3" />
          <span className="text-[10px] font-black tracking-widest uppercase">Local Fallback</span>
        </Badge>
      )}

      {!status?.connected && (
        <span className="text-[9px] text-slate-500 font-medium max-w-[120px] truncate" title={status?.error}>
          {status?.error || "Check .env configuration"}
        </span>
      )}
    </motion.div>
  );
}
